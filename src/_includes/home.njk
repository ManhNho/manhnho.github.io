{% set blogUrl = "/blog/" if lang == "en" else "/vi/blog/" %}
{% set posts = collections.posts_en if lang == "en" else collections.posts_vi %}

<section class="hero">
  <div class="hero-text">
    <h1 class="hero-name">Manh Pham</h1>
    <p class="hero-role">CEO · Security Expert · <span class="nowrap">Bug Bounty Hunter</span></p>

    <div class="hero-spotlight">
      <p>{{ t[lang].hero_biz }}</p>
      <p>{{ t[lang].hero_intro }}</p>
    </div>

    <div class="hero-meta">
      {% for s in site.stats %}
      <div class="item"><div class="num">{{ s.value }}</div><div class="cap">{{ s.label[lang] }}</div></div>
      {% endfor %}
    </div>

    <blockquote class="hero-quote">"{{ site.motto[lang] }}"</blockquote>

    <div class="hero-flag">
      <img src="/assets/img/acropolis/vn.svg" alt="Vietnam" width="30" height="20">
      <span>Hanoi, Vietnam</span>
    </div>
  </div>

  <div class="hero-portrait">
    <div class="glitch">
      <picture>
        <source srcset="/assets/img/acropolis/portrait.webp" type="image/webp">
        <img src="/assets/img/acropolis/portrait.jpg" alt="Pham Tien Manh — ManhNho" width="340" height="453" fetchpriority="high">
      </picture>
      <div class="glitch__layers" aria-hidden="true">
        <div class="glitch__layer" style="background-image:url('/assets/img/acropolis/portrait.webp')"></div>
        <div class="glitch__layer" style="background-image:url('/assets/img/acropolis/portrait.webp')"></div>
        <div class="glitch__layer"></div>
      </div>
    </div>
  </div>
</section>

{% set extIcon %}<svg class="ext-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>{% endset %}
{% set chevron %}<svg class="section-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>{% endset %}

{# ---- Section navigation bar ---- #}
<nav class="section-nav" id="section-nav" aria-label="Page sections">
  <div class="section-nav-inner container" role="tablist">
    <button class="snav-tab" id="tab-wanted" data-section="wanted" role="tab" aria-selected="false" aria-controls="panel-wanted">{{ t[lang].wb_title }}</button>
    <button class="snav-tab" id="tab-recognition" data-section="recognition" role="tab" aria-selected="false" aria-controls="panel-recognition">{{ t[lang].recognition }}</button>
    <button class="snav-tab" id="tab-certs" data-section="certs" role="tab" aria-selected="false" aria-controls="panel-certs">{{ t[lang].certs }}</button>
    {% if site.press | length %}<button class="snav-tab" id="tab-press" data-section="press" role="tab" aria-selected="false" aria-controls="panel-press">{{ t[lang].press_title }}</button>{% endif %}
    {% if gallery | length %}<button class="snav-tab" id="tab-gallery" data-section="gallery" role="tab" aria-selected="false" aria-controls="panel-gallery">{{ t[lang].gallery }}</button>{% endif %}
    {% if posts | length %}<button class="snav-tab" id="tab-posts" data-section="posts" role="tab" aria-selected="false" aria-controls="panel-posts">{{ t[lang].latest_posts }}</button>{% endif %}
  </div>
</nav>

<div id="section-panels">

{# ---- Wanted Board: custom pen-and-ink insect badge icons ---- #}
{% set wbIcons = {
  revenue: "grasshopper",
  client: "beetle",
  global: "mosquito",
  team: "wasp",
  engineer: "spider",
  partner: "bee",
  capital: "scorpion",
  product: "mantis",
  cert: "moth",
  stage: "cicada",
  globalRev: "rhino-beetle",
  presence: "flea"
} %}
{% macro wbIcon(key) %}
<img src="/assets/img/wb/{{ wbIcons[key] }}.webp" alt="{{ key }}" loading="lazy" width="72" height="72">
{% endmacro %}

{% set starFilled %}<svg class="wb-star filled" viewBox="0 0 16 16" width="13" height="13"><path d="M8 1l2.2 4.4L15 6.3l-3.5 3.4.8 4.9L8 12.4l-4.3 2.2.8-4.9L1 6.3l4.8-.9L8 1z" fill="currentColor" stroke="none"/></svg>{% endset %}
{% set starEmpty %}<svg class="wb-star empty" viewBox="0 0 16 16" width="13" height="13"><path d="M8 1l2.2 4.4L15 6.3l-3.5 3.4.8 4.9L8 12.4l-4.3 2.2.8-4.9L1 6.3l4.8-.9L8 1z" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>{% endset %}

<section class="section section-panel" data-section-panel="wanted" id="panel-wanted" role="tabpanel" aria-labelledby="tab-wanted">
  <h2 class="section-title"><button aria-expanded="true" aria-controls="sb-wanted">{{ t[lang].wb_title }} {{ chevron | safe }}</button></h2>
  <div class="section-body" id="sb-wanted">
    <div class="wb-sub">
      <span class="wb-logo" aria-label="CyPeace">{% for ch in ["c","y","p","e1","a","c2","e2"] %}<img src="/assets/img/logos/cp-{{ ch }}.png" alt="" class="wb-logo-ch" loading="lazy" width="28" height="28" aria-hidden="true">{% endfor %}</span>
    </div>
    <div class="wb-tabs">
      <button class="wb-tab is-active" data-wb-tab="achieved">{{ t[lang].wb_tab_achieved }} ({{ site.wbCounts.achieved }})</button>
      <button class="wb-tab" data-wb-tab="progress">{{ t[lang].wb_tab_progress }} ({{ site.wbCounts.progress }})</button>
      <button class="wb-tab" data-wb-tab="locked">{{ t[lang].wb_tab_locked }} ({{ site.wbCounts.locked }})</button>
    </div>
    <div class="wb-grid" data-wb-view="achieved">
      {% for w in site.wantedBoard %}
      {% if w._tab != "hidden" %}
      <div class="wb-card{% if w.status == 'captured' %} done{% elif w.status == 'in-progress' %} active{% elif w.status == 'locked' %} locked{% endif %}" data-wb-tab="{{ w._tab }}" role="button" tabindex="0" aria-label="{{ w.name[lang] }}">
        <span class="wb-cat">{{ w.cat[lang] }}</span>
        <div class="wb-card-icon">{{ wbIcon(w.icon) }}</div>
        <div class="wb-stars">{% for i in range(0, w.stars) %}{{ starFilled | safe }}{% endfor %}{% for i in range(w.stars, 5) %}{{ starEmpty | safe }}{% endfor %}</div>
        <div class="wb-card-name">{{ w.name[lang] }}</div>
        {% if w.date %}<div class="wb-card-date">{{ w.date[lang] }}</div>{% endif %}
        {% if w.status == "in-progress" %}<div class="wb-card-date wip">{{ t[lang].wb_in_progress }}</div>{% endif %}
        <div class="wb-card-desc">{{ w.desc[lang] }}</div>
      </div>
      {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section-panel" data-section-panel="recognition" id="panel-recognition" role="tabpanel" aria-labelledby="tab-recognition">
  <h2 class="section-title"><button aria-expanded="true" aria-controls="sb-recognition">{{ t[lang].recognition }} {{ chevron | safe }}</button></h2>
  <div class="section-body" id="sb-recognition">

  <div class="pinned-grid">
    {% for p in site.pinned %}
    <div class="pinned-card" data-img="/assets/img/{{ p.img }}" role="button" tabindex="0" aria-label="{{ p.rank }} — {{ t[lang].view_hint }}">
      <span class="pin-flag">{{ t[lang].pinned_label }}</span>
      <div class="pin-head">
        <img src="/assets/img/{{ p.logo }}" alt="{{ p.rank }}" class="pin-logo{% if p.tint %} tint{% endif %}" width="130" height="46">
        <span class="pin-rank">{{ p.rank | safe }}</span>
      </div>
      <p class="pin-text">{{ p[lang] | safe }}</p>
      <a class="pin-foot verify-link" href="{{ p.link }}" target="_blank" rel="noopener noreferrer">{{ p.year }} · {{ t[lang].verify }} {{ extIcon | safe }}</a>
    </div>
    {% endfor %}
  </div>

  <div class="acropolis-rail">
    <span class="rail-label">Synack Acropolis</span>
    <div class="awards-by-year">
      {% for r in site.recognitions %}
      <div class="year-group" data-img="/assets/img/{{ r.img }}" role="button" tabindex="0" aria-label="Synack {{ r.year }} — {{ t[lang].view_hint }}">
        <div class="yr">{{ r.year }}</div>
        <div class="year-node"></div>
        <div class="year-badges">
          {% for b in r.badges %}
          <div class="badge">
            <img src="/assets/img/acropolis/{{ b.img }}" alt="{{ b.name }}" width="80" height="80" loading="lazy">
            <span class="bname">{{ b.name }}</span>
          </div>
          {% endfor %}
        </div>
        <a class="year-verify verify-link" href="{{ r.link }}" target="_blank" rel="noopener noreferrer">{{ t[lang].verify }} {{ extIcon | safe }}</a>
      </div>
      {% endfor %}
    </div>
  </div>

  <h3 class="sub-label">{{ t[lang].hall_of_fame_label }}</h3>
  <div class="logo-wall">
    {% for h in site.halls %}
    <div class="logo-cell" data-img='{% if h.imgs %}{{ h.imgs | dump | safe }}{% else %}/assets/img/{{ h.img }}{% endif %}' role="button" tabindex="0" aria-label="{{ h.org }} — {{ t[lang].view_hint }}">
      <div class="logo-top">
        <img class="brand-logo" src="/assets/img/logos/{{ h.logo }}" alt="{{ h.org }}" width="128" height="40" loading="lazy">
      </div>
      <div class="logo-note">{{ h.note[lang] }}</div>
      <div class="logo-foot">
        <span class="logo-year">{{ h.years }}</span>
        <a class="verify-tag verify-link" href="{{ h.link }}" target="_blank" rel="noopener noreferrer">{{ t[lang].verify }} {{ extIcon | safe }}</a>
      </div>
    </div>
    {% endfor %}
  </div>
  </div>
</section>

<section class="section section-panel" data-section-panel="certs" id="panel-certs" role="tabpanel" aria-labelledby="tab-certs">
  <h2 class="section-title"><button aria-expanded="true" aria-controls="sb-certs">{{ t[lang].certs }} {{ chevron | safe }}</button></h2>
  <div class="section-body" id="sb-certs">
  <div class="cert-grid">
    {% for c in site.certs %}
    <div class="cert-card" data-img="/assets/img/{{ c.img }}" role="button" tabindex="0" aria-label="{{ c.name }} — {{ t[lang].view_hint }}">
      <img class="cert-logo {{ c.type }}" src="/assets/img/logos/{{ c.logo }}" alt="{{ c.vendor }}" width="48" height="48" loading="lazy">
      <div class="cert-info">
        <div class="cert-name">{{ c.name }}</div>
        <div class="cert-vendor">{{ c.vendor }} · {{ c.year }}</div>
      </div>
      <a class="cert-verify verify-link" href="{{ c.link }}" target="_blank" rel="noopener noreferrer">{{ t[lang].verify }} {{ extIcon | safe }}</a>
    </div>
    {% endfor %}
  </div>
  </div>
</section>

{% if site.press | length %}
<section class="section section-panel" data-section-panel="press" id="panel-press" role="tabpanel" aria-labelledby="tab-press">
  <h2 class="section-title"><button aria-expanded="true" aria-controls="sb-press">{{ t[lang].press_title }} {{ chevron | safe }}</button></h2>
  <div class="section-body" id="sb-press">
  <div class="press-paper">
    <div class="press-mast">
      <div class="press-mast-rule heavy"></div>
      <div class="press-mast-name">{{ t[lang].press_title }}</div>
      <div class="press-mast-rule light"></div>
      <div class="press-mast-sub">
        <span class="press-mast-tag">Pham Tien Manh</span>
        <span class="press-mast-tag">ManhNho</span>
      </div>
    </div>
    <div class="press-page-num left">2</div>
    <div class="press-page-num right">3</div>
    <div class="press-spread">
      {% for p in site.press %}
      <a class="press-art{% if p.img %} has-img{% endif %}" href="{{ p.link }}" target="_blank" rel="noopener noreferrer" style="--clip-accent: {{ p.color }}">
        <div class="press-art-src">
          <img src="/assets/img/press/{{ p.icon }}.webp" alt="" class="press-art-icon" width="16" height="16" loading="lazy" aria-hidden="true">
          <span class="press-art-pub">{{ p.pub }}</span>
          <span class="press-art-date">{{ p.date }}</span>
        </div>
        {% if p.img %}
        <div class="press-art-photo">
          <img src="/assets/img/press/{{ p.img }}" alt="{{ p.title }}" loading="lazy" width="400" height="240">
        </div>
        {% endif %}
        <div class="press-art-hl">{{ p.title }}</div>
        <span class="press-art-read">{{ t[lang].press_read }} {{ extIcon | safe }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
  </div>
</section>
{% endif %}

{% if gallery | length %}
<section class="section section-panel" data-section-panel="gallery" id="panel-gallery" role="tabpanel" aria-labelledby="tab-gallery">
  <h2 class="section-title"><button aria-expanded="true" aria-controls="sb-gallery">{{ t[lang].gallery }} {{ chevron | safe }}</button></h2>
  <div class="section-body" id="sb-gallery">
  <div class="pov-cmd mono">
    <span class="pov-prompt">manhnho@hangout</span><span class="pov-colon">:</span><span class="pov-path">~/pov</span><span class="pov-dollar">$</span>
    shuf *.jpg | head -<input id="pov-count" class="pov-count mono" type="text" inputmode="numeric" pattern="[0-9]*" maxlength="3" value="05" aria-label="{{ t[lang].gallery_count_aria }}"><span class="pov-cursor">▊</span>
  </div>
  <div id="pov-gallery" class="pov-gallery" aria-live="polite"
       data-images='{{ gallery | dump | safe }}'
       data-count="5"></div>
  <div class="pov-actions">
    <button id="pov-shuffle" class="pov-shuffle mono" type="button">./shuffle {{ t[lang].gallery_shuffle }} ⟳</button>
  </div>
  </div>
</section>
{% endif %}

{# Lightbox for cert / recognition images (with the same glitch effect as the avatar) #}
<div id="lightbox" class="lightbox" hidden aria-modal="true" role="dialog" aria-label="Image viewer">
  <button class="lightbox-close" aria-label="Close">✕</button>
  <button id="lb-prev" class="lb-nav lb-prev" aria-label="Previous" hidden>‹</button>
  <button id="lb-next" class="lb-nav lb-next" aria-label="Next" hidden>›</button>
  <div class="glitch lb-glitch">
    <img id="lb-img" src="" alt="">
    <div class="glitch__layers" aria-hidden="true">
      <div class="glitch__layer"></div>
      <div class="glitch__layer"></div>
      <div class="glitch__layer"></div>
    </div>
  </div>
  <div id="lb-counter" class="lb-counter mono" hidden></div>
</div>

{% if posts | length %}
<section class="section section-panel" data-section-panel="posts" id="panel-posts" role="tabpanel" aria-labelledby="tab-posts">
  <h2 class="section-title"><button aria-expanded="true" aria-controls="sb-posts">{{ t[lang].latest_posts }} {{ chevron | safe }}</button></h2>
  <div class="section-body" id="sb-posts">
  <div class="post-list">
    {% for post in posts %}
      {% if loop.index <= 3 %}
      <a class="post-card" href="{{ post.url }}">
        <h3>{{ post.data.title }}</h3>
        <div class="meta">{{ post.date | readableDate(lang) }}{% if post.data.tags_list %} · {% for tag in post.data.tags_list %}<span class="tag">#{{ tag }}</span>{% endfor %}{% endif %}</div>
        <p>{{ post.data.description }}</p>
      </a>
      {% endif %}
    {% endfor %}
  </div>
  <p style="margin-top:1.2rem"><a class="mono" href="{{ blogUrl }}">{{ t[lang].all_posts }}</a></p>
  </div>
</section>
{% endif %}

</div>{# /section-panels #}
